# =============================================================================
# MUSIC PLATFORM SELECTION
# =============================================================================
# Options: youtube_music, spotify
# Default: youtube_music (no API key needed for basic features)
MUSIC_PLATFORM=youtube_music

# =============================================================================
# YOUTUBE MUSIC (Recommended - No API key required)
# =============================================================================
# Authentication file path (auto-generated on first run)
# Leave empty to use default: ./data/ytmusic_auth.json
YTMUSIC_AUTH_FILE=

# Auth type: oauth (recommended) or browser
YTMUSIC_AUTH_TYPE=oauth

# =============================================================================
# SPOTIFY (Optional - Requires developer account)
# =============================================================================
# Get these from https://developer.spotify.com/dashboard
# Note: Spotify is currently not accepting new app registrations
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# =============================================================================
# LLM PROVIDER (Optional)
# =============================================================================
# Options: rule_based, groq, gemini
# Default: rule_based (free, no API needed)
LLM_PROVIDER=rule_based

# Only needed if using groq or gemini
# Groq: https://console.groq.com/keys (free tier available)
# Gemini: https://aistudio.google.com/apikey (free tier available)
LLM_API_KEY=

# =============================================================================
# TELEGRAM BOT
# =============================================================================
# Get from @BotFather on Telegram
# 1. Message @BotFather
# 2. Send /newbot
# 3. Copy the token here
TELEGRAM_BOT_TOKEN=

# =============================================================================
# OTHER
# =============================================================================
# Debug mode
DEBUG=false
